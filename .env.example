# Konfiguracja CLI dla JDG: pobranie faktur z KSeF, budowa JPK_V7M i wysyłka
# do bramki e-Dokumenty z danymi autoryzującymi (bez certyfikatu).
# Skopiuj do .env, uzupełnij własnymi danymi i załaduj:
#   set -a; source .env; set +a

# ── KSeF (ufirma ksef download) ────────────────────────────────────────────

# Środowisko: test | demo | prod
KSEF_ENV=prod
KSEF_NIP=1111111111
# Token z aplikacji podatnika KSeF (w cudzysłowie — zawiera znaki |)
KSEF_TOKEN="numer-referencyjny|nip-1111111111|sekret"

# ── Podatnik (ufirma jpk generate) ─────────────────────────────────────────

JPK_NIP=1111111111
JPK_TAXPAYER_FIRST_NAME=Jan
JPK_TAXPAYER_LAST_NAME=Kowalski
JPK_TAXPAYER_BIRTH_DATE=1980-05-01
JPK_TAXPAYER_EMAIL=jan.kowalski@example.com
# Czterocyfrowy kod urzędu skarbowego
JPK_TAX_OFFICE=0202

# ── Bramka e-Dokumenty (ufirma jpk send, dane autoryzujące) ────────────────

# Środowisko: test | prod
JPK_BRAMKA_ENV=prod
# Kwota przychodu z zeznania (np. PIT-36) za rok podatkowy o dwa lata
# wcześniejszy niż rok wysyłki, 0 gdy brak. Resztę danych autoryzujących
# (NIP, imię, nazwisko, data urodzenia) ufirma jpk send bierze z wartości powyżej.
JPK_REVENUE=123456.78
